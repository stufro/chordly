#style-modal.modal data-modal-target="modal"
  .modal-background data-action="click->modal#close"
  .modal-card
    header.modal-card-head
      p.modal-card-title Style
      button.delete type="button" aria-label="close" data-action="modal#close"
    section.modal-card-body data-controller="tabs"
      / Previews follow the checked options as they're picked, using the same CSS the sheet gets
      style
        - LineStyle::FONT_STYLES.each do |font_style, css|
          | .style-panel:has(input[name$="[font_style]"][value="#{font_style}"]:checked) .style-preview { #{css} }
        - LineStyle::COLOURS.each do |colour, hex|
          | .style-panel:has(input[name$="[colour]"][value="#{colour}"]:checked) .style-preview { color: #{hex} }
        - LineStyle::FONT_SIZES.each do |font_size, size|
          | .style-panel:has(input[name$="[font_size]"][value="#{font_size}"]:checked) .style-preview { font-size: #{size} }
        - ChordSheet::TEXT_SIZES.each do |text_size, size|
          | #style-modal:has(input[name$="[text_size]"][value="#{text_size}"]:checked) pre { font-size: #{size} }

      = form_with model: chord_sheet, method: :patch, id: "style-form" do |form|
        .field
          p.label Text size
          .style-options
            - ChordSheet::TEXT_SIZES.each_key do |text_size|
              = form.radio_button :text_size, text_size
              = form.label :text_size, text_size.humanize, value: text_size, class: "style-option"
          p.help
            span.icon.is-small
              i.fas.fa-info-circle
            |  Chords and lyrics share one size so chords stay above the right words. Headings scale with it.

        .tabs.is-centered.is-medium
          ul
            - LineStyle.line_types.each_key do |line_type|
              li class=("is-active" if line_type == "chords") data-tabs-target="tab"
                a href="#" data-action="tabs#select" = line_type.humanize

        - samples = { "chords" => "G     Am     D", "lyrics" => "Lyrics of the song", "heading" => "[Verse 1]" }
        - LineStyle.line_types.each_key do |line_type|
          div[id="line-style-panel-#{line_type}" class=class_names("style-panel", "is-hidden": line_type != "chords")
              data-tabs-target="panel"]
            = form.fields_for :line_styles, chord_sheet.line_style_for(line_type) do |style_fields|
              = style_fields.hidden_field :line_type
              pre.mb-4
                span.style-preview = samples[line_type]

              .field
                p.label Font style
                .style-options
                  - LineStyle::FONT_STYLES.each do |font_style, css|
                    = style_fields.radio_button :font_style, font_style
                    = style_fields.label :font_style, font_style.humanize, value: font_style, class: "style-option", style: css

              .field
                p.label Colour
                .style-options
                  = style_fields.radio_button :colour, ""
                  = style_fields.label :colour, "Default", value: "", class: "style-option"
                  - LineStyle::COLOURS.each do |colour, hex|
                    = style_fields.radio_button :colour, colour
                    = style_fields.label :colour, value: colour, class: "style-option is-swatch", title: colour.humanize,
                                                  style: "background-color: #{hex}" do
                      span.is-sr-only = colour.humanize

              - if line_type == "heading"
                .field
                  p.label Size
                  / Headings saved before sizes existed have none, which renders as normal
                  .style-options
                    - LineStyle::FONT_SIZES.each_key do |font_size|
                      = style_fields.radio_button :font_size, font_size,
                                                  checked: font_size == (style_fields.object.font_size || "normal")
                      = style_fields.label :font_size, font_size.humanize, value: font_size, class: "style-option"

    footer.modal-card-foot
      .buttons
        button.button.is-primary#save-styles type="submit" form="style-form" Save
        - if user_signed_in?
          button.button#apply-styles-to-all[type="submit" form="style-form" name="apply_to_all"
            value="1" data-turbo-confirm="Save these styles, use them for new chord sheets and replace them on all your chord sheets?"]
            span.icon
              i.fas.fa-layer-group
            span Apply to all sheets
        = button_to chord_sheet_style_path(chord_sheet), method: :delete, class: "button", id: "reset-styles",
                    form: { data: { turbo_confirm: "Reset this chord sheet to Chordly's default styles?" } }
          span.icon
            i.fas.fa-rotate-left
          span Reset
