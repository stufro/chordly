- two_columns = chord_sheet.two_columns?
- section_style = "display: inline-block; width: 100%; white-space: pre; " \
                  "-webkit-column-break-inside: avoid; break-inside: avoid;"

div
  pre style=("-webkit-column-count: 2; column-count: 2; white-space: normal;" if two_columns)
    - chord_sheet.sections.each do |section|
      span style=(section_style if two_columns)
        - section.each do |line|
          span style=(line["type"] == "chords" ? "font-weight: bold;" : "")
            = line["content"]
