div
  pre style=("-webkit-column-count: 2; column-count: 2;" if chord_sheet.two_columns?)
    - chord_sheet.sections.each do |section|
      span style="display: inline-block; width: 100%; -webkit-column-break-inside: avoid; break-inside: avoid;"
        - section.each do |line|
          span style=(line["type"] == "chords" ? "font-weight: bold;" : "")
            = line["content"]
