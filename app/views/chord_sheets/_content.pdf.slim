- two_columns = chord_sheet.two_columns?
- section_style = "display: inline-block; width: 100%; -webkit-column-break-inside: avoid; break-inside: avoid;"

div
  pre style=("-webkit-column-count: 2; column-count: 2;" if two_columns)
    - chord_sheet.sections.each do |section|
      div style=(section_style if two_columns)
        - section.each do |line|
          div style=("font-weight: bold;" if line["type"] == "chords")
            = wrappable_line(line["content"])
