.field
  = f.label :name, class: "label"
  .control
    = f.text_field :name, class: "input"

.field
  = f.label :content, class: "label mb-1"
  details.mb-2
    summary.is-size-7.has-text-grey
      span.icon
        i.fas.fa-info-circle
      | How Chordly reads each line
    .is-size-7.mt-2
      = render("chord_sheets/line_type_help")

  .control
    = f.text_area :content, class: "textarea",
                            placeholder: "Paste your chord sheet here",
                            data: { controller: "textarea-autogrow" }

.field
  .control
    = f.submit class: "button is-primary", id: "create-btn"
