turbo-frame[id=dom_id(chord_sheet) data-controller="clipboard chord-diagram modal"
    data-action="click@document->chord-diagram#closeOnClickOutside turbo:frame-render->chord-diagram#show"
    data-clipboard-success-content-value="<span class='icon'><i class='fas fa-check'></i></span>"]
  = turbo_stream.replace "flash-message-container", partial: "partials/flash"
  .card.mb-3
    .card-content.chord-sheet-toolbar.is-flex.is-flex-wrap-wrap.is-justify-content-space-between.is-column-gap-5.is-row-gap-3[
      data-controller="tooltip"]
      .is-flex.is-flex-wrap-wrap.is-column-gap-5.is-row-gap-3
        .toolbar-group
          p.toolbar-label Transpose
          .buttons.mb-0
            = button_to transpose_chord_sheet_path(chord_sheet, direction: "up"),
              class: "button is-rounded is-primary has-tooltip", aria: { label: "Transpose up a semitone" },
              id: "transpose-up", data: { tooltip_target: "button" }, method: :put do
              span.icon
                i.fas.fa-arrow-up

            = button_to transpose_chord_sheet_path(chord_sheet, direction: "down"),
              class: "button is-rounded is-primary has-tooltip", aria: { label: "Transpose down a semitone" },
              id: "transpose-down", data: { tooltip_target: "button" }, method: :put
              span.icon
                i.fas.fa-arrow-down

        .toolbar-group
          p.toolbar-label Layout/Style
          .buttons.mb-0
            = button_to chord_sheet_path(chord_sheet),
              params: { chord_sheet: { two_columns: !chord_sheet.two_columns? } },
              class: class_names("button is-rounded is-primary has-tooltip", "is-outlined": !chord_sheet.two_columns?),
              aria: { label: "Show in two columns", pressed: chord_sheet.two_columns? },
              id: "toggle-columns", data: { tooltip_target: "button" }, method: :patch
              span.icon
                i.fas.fa-table-columns

            = button_to compact_chord_sheet_path(chord_sheet),
              class: "button is-rounded is-primary has-tooltip", aria: { label: "Compact: remove blank lines" },
              id: "compact", data: { tooltip_target: "button" }, method: :put
              span.icon
                i.fas.fa-text-height

            button.button.is-rounded.is-primary.has-tooltip.modal-trigger#style-chord-sheet[
              type="button" aria-label="Style chord sheet" data-target="style-modal" data-tooltip-target="button"]
              span.icon
                i.fas.fa-palette

            .dropdown.is-right#chord-diagram-dropdown[data-turbo-permanent data-chord-diagram-target="wrapper"]
              .dropdown-trigger
                button.button.is-rounded.is-primary.is-outlined.has-tooltip#chord-diagram[
                  aria-label="Show chord diagrams" aria-haspopup="true" aria-controls="diagram-select"
                  data-chord-diagram-target="button" data-tooltip-target="button"
                  data-action="chord-diagram#click_icon"]
                  span.icon
                    = render("chord_diagram_icon")
              .dropdown-menu#diagram-select role="menu"
                .dropdown-content
                  button.dropdown-item#guitar data-action="chord-diagram#set" Guitar
                  button.dropdown-item#ukulele data-action="chord-diagram#set" Ukulele

      .toolbar-group#toolbar-actions[data-turbo-permanent]
        p.toolbar-label Actions
        .buttons.mb-0
          = button_to("#", class: "button is-rounded is-info modal-trigger has-tooltip",
                           id: "versions", aria: { label: "Previous versions" },
                           data: { target: "versions-modal", tooltip_target: "button" })
            span.icon
              i.fas.fa-history
          = button_to "#", class: "button is-rounded is-info has-tooltip", id: "copy-to-clipboard",
            "data-clipboard-target" => "button", "data-tooltip-target" => "button", "data-action" => "clipboard#copy",
            aria: { label: "Copy to clipboard" }
            span.icon
              i.fas.fa-copy
          = button_to chord_sheet_path(chord_sheet, format: :pdf),
            class: "button is-rounded is-info has-tooltip", id: "export", disabled: !user_signed_in?,
            aria: { label: user_signed_in? ? "Download PDF" : "Log in to download PDF" },
            data: { pdf_download_target: "button", tooltip_target: "button" },
            form: { data: { controller: "pdf-download", action: "submit->pdf-download#download",
                            pdf_download_filename_value: "#{chord_sheet.name}.pdf" } },
            method: :get
            span.icon
              i.fas.fa-download
          = button_to(chord_sheet_path(chord_sheet), class: "button is-danger is-rounded has-tooltip",
              id: "delete-chord-sheet", aria: { label: "Delete chord sheet" }, data: { tooltip_target: "button" },
              form: { data: { turbo_frame: "_top", turbo_confirm: "Are you sure?" } },
              method: :delete)
            span.icon
              i.fas.fa-trash

  - if chord_sheet.two_columns?
    .notification.is-info.is-light.is-hidden-tablet
      .is-flex.is-align-items-center
        span.icon.mr-2
          i.fas.fa-info-circle
        span The two-column layout might not be visible on your screen size.

  = render("content", chord_sheet:)

  #style-modal.modal
    .modal-background
    .modal-card
      header.modal-card-head
        p.modal-card-title Style
        button.delete type="button" aria-label="close"
      section.modal-card-body
        = form_with model: chord_sheet, method: :patch, id: "style-form" do |form|
          - LineStyle.line_types.each_key do |line_type|
            = form.fields_for :line_styles, chord_sheet.line_style_for(line_type) do |style_fields|
              fieldset.mb-5
                legend.title.is-5.mb-3 = line_type.humanize
                = style_fields.hidden_field :line_type

                .field
                  p.label Font style
                  .style-options
                    - LineStyle::FONT_STYLES.each do |font_style, css|
                      = style_fields.radio_button :font_style, font_style,
                                                  id: "line_style_#{line_type}_font_style_#{font_style}"
                      label.style-option[for="line_style_#{line_type}_font_style_#{font_style}" style="#{css}"]
                        = font_style.humanize

                .field
                  p.label Colour
                  .style-options
                    = style_fields.radio_button :colour, "", id: "line_style_#{line_type}_colour_default"
                    label.style-option for="line_style_#{line_type}_colour_default" Default
                    - LineStyle::COLOURS.each do |colour, hex|
                      = style_fields.radio_button :colour, colour, id: "line_style_#{line_type}_colour_#{colour}"
                      label.style-option.is-swatch[for="line_style_#{line_type}_colour_#{colour}" title=colour.humanize
                                                   aria-label=colour.humanize style="background-color: #{hex}"]
      footer.modal-card-foot
        button.button.is-primary#save-styles type="submit" form="style-form" Save
